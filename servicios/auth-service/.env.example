# Copia este archivo como .env y completa con tus datos.
# Cadena de conexión a PostgreSQL (Neon, Supabase, Render, etc.)
DATABASE_URL=postgresql://usuario:password@host/base_de_datos?sslmode=require
# Clave para firmar los tokens JWT (usa una cadena larga y privada)
JWT_SECRET=cambia_esta_clave_por_una_segura
PORT=4001
